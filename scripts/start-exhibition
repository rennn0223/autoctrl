#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
PROJECT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd)"
cd "$PROJECT_DIR"

ROBOT_SSH="${AUTOCTRL_ROBOT_SSH:-wheeltec@100.64.0.5}"
ROBOT_ZENOH_DIR="${AUTOCTRL_ROBOT_ZENOH_DIR:-/opt/zenoh-bridge}"
LOCAL_ZENOH_DIR="${AUTOCTRL_LOCAL_ZENOH_DIR:-/opt/zenoh-bridge}"
ROS_SETUP="${AUTOCTRL_ROS_SETUP:-/opt/ros/jazzy/setup.bash}"
ISAAC_ROS_SETUP="${ISAAC_ROS_SETUP:-$HOME/IsaacSim-ros_workspaces/jazzy_ws/install/setup.bash}"
ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-2}"
ROS_AUTOMATIC_DISCOVERY_RANGE="${ROS_AUTOMATIC_DISCOVERY_RANGE:-LOCALHOST}"
STARTUP_LOG="${AUTOCTRL_STARTUP_LOG:-/tmp/autoctrl-startup.log}"
TWIN_MODE="${AUTOCTRL_TWIN_MODE:-auto}"
SIM_NAMESPACE="${AUTOCTRL_SIM_NAMESPACE:-/sim}"
TWIN_LOG="${AUTOCTRL_TWIN_LOG:-/tmp/autoctrl-twin.log}"
TWIN_CONVERTER_PID=""
TWIN_READY=0
SKIP_ROBOT=0
SKIP_BRIDGES=0
VERBOSE=0

usage() {
  printf '%s\n' \
    "用法：./scripts/start-exhibition [選項] [-- ROS2 參數]" \
    "" \
    "  --skip-robot    不透過 SSH 啟動小車 bridge 與底盤 driver" \
    "  --skip-bridges  不重啟兩端 bridge，直接啟動 AutoCtrl" \
    "  --verbose       顯示 bridge、ROS discovery 與 uv 的完整啟動輸出" \
    "  --help          顯示說明" \
    "" \
    "預設立即準備 /sim 虛實同動通道；Isaac Sim 可在啟動前或啟動後接入。" \
    "設定 AUTOCTRL_TWIN_MODE=off 可停用；on 與預設模式皆會啟用虛實通道。" \
    "一般啟動不等待實車 topics；CLI 會自動執行 /doctor，且失敗不阻止開啟。" \
    "完整啟動紀錄預設寫入：$STARTUP_LOG"
}

ROS_ARGS=()
while (($#)); do
  case "$1" in
    --skip-robot)
      SKIP_ROBOT=1
      shift
      ;;
    --skip-bridges)
      SKIP_BRIDGES=1
      shift
      ;;
    --verbose)
      VERBOSE=1
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      ROS_ARGS=("$@")
      break
      ;;
    *)
      echo "未知選項：$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ ! -f "$ROS_SETUP" ]]; then
  echo "找不到 ROS2 環境：$ROS_SETUP" >&2
  exit 1
fi

export ROS_DOMAIN_ID ROS_AUTOMATIC_DISCOVERY_RANGE
set +u
source "$ROS_SETUP"
if [[ -f "$ISAAC_ROS_SETUP" ]]; then
  source "$ISAAC_ROS_SETUP"
fi
set -u

: >"$STARTUP_LOG"
STARTUP_WARNINGS=()

verbose() {
  if ((VERBOSE)); then
    printf '• %s\n' "$1"
  fi
}

remember_warning() {
  STARTUP_WARNINGS+=("$1")
  if ((VERBOSE)); then
    printf 'FAIL %s\n' "$1" >&2
  fi
}

run_optional() {
  local label="$1"
  shift
  verbose "$label"
  if ((VERBOSE)); then
    if ! "$@"; then
      remember_warning "$label 失敗；詳見 $STARTUP_LOG"
    fi
  elif ! "$@" >>"$STARTUP_LOG" 2>&1; then
    remember_warning "$label 失敗；詳見 $STARTUP_LOG"
  fi
}

start_robot() {
  ssh -tt "$ROBOT_SSH" \
    "export ROS_AUTOMATIC_DISCOVERY_RANGE='$ROS_AUTOMATIC_DISCOVERY_RANGE' ROS_DOMAIN_ID='$ROS_DOMAIN_ID'; sudo ip link set lo multicast on; cd '$ROBOT_ZENOH_DIR'; sudo docker compose down; sudo docker compose up -d; if pgrep -f '[r]os2 launch turn_on_wheeltec_robot turn_on_wheeltec_robot.launch.py' >/dev/null; then echo 'WHEELTEC driver 已經在執行'; else nohup zsh -lic \"export ROS_AUTOMATIC_DISCOVERY_RANGE='$ROS_AUTOMATIC_DISCOVERY_RANGE'; export ROS_DOMAIN_ID='$ROS_DOMAIN_ID'; ros2 launch turn_on_wheeltec_robot turn_on_wheeltec_robot.launch.py\" >/tmp/autoctrl-wheeltec-driver.log 2>&1 </dev/null & sleep 3; pgrep -af '[r]os2 launch turn_on_wheeltec_robot' || exit 1; fi"
}

start_local_bridge() {
  if ! ip link show lo | grep -qw MULTICAST; then
    sudo ip link set lo multicast on
  fi
  [[ -d "$LOCAL_ZENOH_DIR" ]] || return 1
  (
    cd "$LOCAL_ZENOH_DIR"
    docker compose down
    docker compose up -d
  )
}

refresh_ros() {
  ros2 daemon stop >/dev/null 2>&1 || true
  ros2 daemon start >/dev/null
}

sim_topic() {
  printf '/%s/%s' "${SIM_NAMESPACE#/}" "$1"
}

cleanup_twin_converter() {
  if [[ -n "$TWIN_CONVERTER_PID" ]] &&
    kill -0 "$TWIN_CONVERTER_PID" 2>/dev/null; then
    kill "$TWIN_CONVERTER_PID" 2>/dev/null || true
    wait "$TWIN_CONVERTER_PID" 2>/dev/null || true
  fi
}
trap cleanup_twin_converter EXIT

configure_digital_twin() {
  [[ "$TWIN_MODE" != "off" ]] || return 0

  local cmd_vel_topic
  local ackermann_topic
  cmd_vel_topic="$(sim_topic cmd_vel)"
  ackermann_topic="$(sim_topic ackermann_cmd)"

  if pgrep -f '^python3 .*/cmdvel_to_ackermann.py .*__node:=autoctrl_twin_cmdvel_to_ackermann' >/dev/null; then
    TWIN_READY=1
    return 0
  fi

  if ! ros2 pkg executables cmdvel_to_ackermann 2>/dev/null |
    grep -q 'cmdvel_to_ackermann.py'; then
    remember_warning "找不到 cmdvel_to_ackermann；未啟用虛實同動"
    return 0
  fi

  ros2 run cmdvel_to_ackermann cmdvel_to_ackermann.py --ros-args \
    -r __node:=autoctrl_twin_cmdvel_to_ackermann \
    -r /cmd_vel:="$cmd_vel_topic" \
    -r /ackermann_cmd:="$ackermann_topic" \
    -p acceleration:=0.5 \
    -p steering_velocity:=0.5 \
    >"$TWIN_LOG" 2>&1 &
  TWIN_CONVERTER_PID=$!

  sleep 0.2
  if ! kill -0 "$TWIN_CONVERTER_PID" 2>/dev/null; then
    remember_warning "Isaac Sim Ackermann 轉換器啟動失敗；詳見 $TWIN_LOG"
    TWIN_CONVERTER_PID=""
    return 0
  fi
  TWIN_READY=1
}

if ((SKIP_BRIDGES == 0)); then
  if ((SKIP_ROBOT == 0)); then
    run_optional "啟動小車 Zenoh bridge 與底盤 driver" start_robot
  else
    verbose "略過小車啟動"
  fi
  run_optional "啟動 DGX Zenoh bridge" start_local_bridge
else
  verbose "略過兩端 Zenoh bridge 重啟"
fi

run_optional "重整 ROS 2 discovery" refresh_ros

verbose "同步 uv 環境"
if ((VERBOSE)); then
  if ! "$PROJECT_DIR/scripts/bootstrap"; then
    echo "AutoCtrl uv 環境初始化失敗。" >&2
    exit 1
  fi
elif ! "$PROJECT_DIR/scripts/bootstrap" >>"$STARTUP_LOG" 2>&1; then
  echo "AutoCtrl uv 環境初始化失敗；詳見 $STARTUP_LOG" >&2
  tail -n 20 "$STARTUP_LOG" >&2
  exit 1
fi

configure_digital_twin

if ((${#STARTUP_WARNINGS[@]})); then
  printf -v AUTOCTRL_STARTUP_WARNINGS '%s\n' "${STARTUP_WARNINGS[@]}"
  export AUTOCTRL_STARTUP_WARNINGS
else
  unset AUTOCTRL_STARTUP_WARNINGS || true
fi

NODE_ARGS=("${ROS_ARGS[@]}")
if ((TWIN_READY)); then
  if ((${#NODE_ARGS[@]} == 0)) || [[ "${NODE_ARGS[0]}" != "--ros-args" ]]; then
    NODE_ARGS+=("--ros-args")
  fi
  NODE_ARGS+=(
    "-p" "mirror_cmd_vel_topic:=$(sim_topic cmd_vel)"
    "-p" "simulation_odom_topic:=$(sim_topic odom)"
  )
fi

"$PROJECT_DIR/scripts/autoctrl-ros" "${NODE_ARGS[@]}"
